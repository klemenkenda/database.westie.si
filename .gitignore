# Derived from content/ — rebuildable, never authoritative.
content/.cache/
content/.index/
content/.transcripts/

# Vote event log. Runtime state, not content.
data/

# Secrets. Never commit.
public/api/config.local.php
tools/client_secret*.json
tools/token*.json
.env
.env.local

# The built SPA. `npm run build` regenerates it into public/, so none of it is source.
#
# Expressed as "ignore everything except api/" rather than as a list of routes. The list
# form had already drifted: `next.config.mjs` sets `trailingSlash: true`, so every route
# exports as `<route>/index.html`, and rules naming `public/404.html` never matched the
# `public/404/` directory sitting beside it. Two pages' worth of build output was tracked
# and showing up as a diff on every publish. A new route would have silently joined them.
public/*
!public/api/
!public/api/**

# Node / Python
node_modules/
__pycache__/
*.py[cod]
.venv/

# Editors / OS
.DS_Store
Thumbs.db
*.swp

# Next.js build output
web/.next/
web/out/
web/next-env.d.ts
